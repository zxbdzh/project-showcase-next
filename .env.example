# Database
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth
AUTH_SECRET="your-auth-secret-here"
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"
# 部署在 nginx 等反向代理之后时设为 "true",否则 Auth.js 无法识别真实回调域名(本地可不设)
AUTH_TRUST_HOST="true"

# 站点公开地址(用于 sitemap / robots / OG metadataBase)。注意:NEXT_PUBLIC_* 在
# 构建时内联,生产环境必须在 `docker compose build` 之前就填好正确域名。
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 对象存储(S3 兼容:AWS S3 / Cloudflare R2 / MinIO 等 —— 可留空,留空则后台图片降级为手填 URL)
# S3_ENDPOINT:兼容服务必填;AWS 官方 S3 可留空(按 S3_REGION 推导)
#   · R2     https://<account_id>.r2.cloudflarestorage.com
#   · MinIO  https://minio.example.com(并设 S3_FORCE_PATH_STYLE="true")
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# 路径风格:MinIO 等设 "true";R2 / AWS 留空(虚拟主机风格)
S3_FORCE_PATH_STYLE=""
# 对象公开访问基址(CDN / 公开桶);路径风格下通常需带桶名,如 https://minio.example.com/<bucket>
NEXT_PUBLIC_S3_PUBLIC_URL=""

# AI —— provider 二选一:openai(含 OpenAI 兼容端点如 GLM)/ anthropic
AI_PROVIDER="openai"
# 模型 ID;留空则用 provider 默认(openai: gpt-4o-mini / anthropic: claude-3-5-haiku-latest)
AI_MODEL="glm-4-flash"
# AI 分身对话(/api/ai/chat)用的模型,需支持 function calling(多步工具调用实时查库)。
# 思考/reasoner 模型(要求回传 reasoning_content)在此会 400,请用非思考模型;留空回退 AI_MODEL。
AI_MODEL_TOOLS="glm-4-flash"

# OpenAI 或 OpenAI 兼容端点(GLM 等);用官方 OpenAI 时 OPENAI_BASE_URL 可留空
OPENAI_API_KEY="your-openai-or-glm-api-key"
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# Anthropic(当 AI_PROVIDER=anthropic 时使用);ANTHROPIC_BASE_URL 可选(自定义兼容端点)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_BASE_URL=""

# 联系表单邮件(SMTP) —— 可留空;任一缺失则留言不发邮件、仅记录服务端日志。
# 以 QQ 邮箱为例:开启 IMAP/SMTP 后用「授权码」作为 SMTP_PASS(非登录密码)。
#   · QQ   smtp.qq.com   465
#   · 163  smtp.163.com  465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER="you@example.com"
SMTP_PASS=""
# 发件人地址,留空用 SMTP_USER(多数 SMTP 要求与认证账号一致)
SMTP_FROM=""
# 留言收件邮箱(收到访客留言的地址)
CONTACT_TO_EMAIL="me@example.com"

# 网络代理(可选):自托管在国内、需经代理访问 GitHub OAuth 等海外服务时设置。
# 仅影响服务端 fetch(如 GitHub 登录);数据库连接走 TCP,不经此代理、不受影响。
# 容器内访问宿主机上的代理用 host.docker.internal(compose 已配 host-gateway)。
# NO_PROXY 排除无需走代理的地址(如国内 AI 端点),避免绕路或失败。
# HTTP_PROXY="http://host.docker.internal:7890"
# HTTPS_PROXY="http://host.docker.internal:7890"
# NO_PROXY="localhost,127.0.0.1,open.bigmodel.cn"
