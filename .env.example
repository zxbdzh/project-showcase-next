# Database
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth
AUTH_SECRET="your-auth-secret-here"
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"

# 对象存储(S3 兼容:AWS S3 / Cloudflare R2 / MinIO 等 —— 可留空,留空则后台图片降级为手填 URL)
# S3_ENDPOINT:兼容服务必填;AWS 官方 S3 可留空(按 S3_REGION 推导)
#   · R2     https://<account_id>.r2.cloudflarestorage.com
#   · MinIO  https://minio.example.com(并设 S3_FORCE_PATH_STYLE="true")
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# 路径风格:MinIO 等设 "true";R2 / AWS 留空(虚拟主机风格)
S3_FORCE_PATH_STYLE=""
# 对象公开访问基址(CDN / 公开桶);路径风格下通常需带桶名,如 https://minio.example.com/<bucket>
NEXT_PUBLIC_S3_PUBLIC_URL=""

# AI —— provider 二选一:openai(含 OpenAI 兼容端点如 GLM)/ anthropic
AI_PROVIDER="openai"
# 模型 ID;留空则用 provider 默认(openai: gpt-4o-mini / anthropic: claude-3-5-haiku-latest)
AI_MODEL="glm-4-flash"

# OpenAI 或 OpenAI 兼容端点(GLM 等);用官方 OpenAI 时 OPENAI_BASE_URL 可留空
OPENAI_API_KEY="your-openai-or-glm-api-key"
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# Anthropic(当 AI_PROVIDER=anthropic 时使用);ANTHROPIC_BASE_URL 可选(自定义兼容端点)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_BASE_URL=""
